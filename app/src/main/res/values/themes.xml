<?xml version="1.0" encoding="utf-8"?>
<!--
    Тема окна, а не приложения: всё рисует Compose. Здесь только то, что видно до первого кадра.
    Родитель — AppCompat: окно наследует AppCompatActivity ради языка приложения до Android 13
    (PLAN C1 «Язык хранит система»), а она требует темы своего семейства и с чужой не рисует вовсе.

    Объявление **одно на оба времени суток**: `DayNight` сам берёт ночной вариант, а фон до
    первого кадра меняет цвет, а не стиль (`window_background` в values-night). Своё объявление
    для ночи здесь было и разъехалось с этим — осталось на `android:Theme.Material`, и у всех, у
    кого включена тёмная тема, приложение падало на запуске. Держит это WindowThemeTest.
-->
<resources>
    <style name="Theme.MedApp" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
