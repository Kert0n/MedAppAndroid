<?xml version="1.0" encoding="utf-8"?>
<!--
    Тема окна, а не приложения: всё рисует Compose. Здесь только то, что видно до первого кадра.
    Родитель — AppCompat: окно наследует AppCompatActivity ради языка приложения до Android 13
    (PLAN C1 «Язык хранит система»), а она требует темы своего семейства.
-->
<resources>
    <style name="Theme.MedApp" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
